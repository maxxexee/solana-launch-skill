# Eunomia Network environment variables
# https://docs.eunomia-protocol.netlify.app

# Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# RPC endpoints
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Vault wallet (for faucet claims only)
VAULT_PRIVATE_KEY=your-vault-private-key-here
EUN_CONTRACT_ADDRESS=0xYourEUNContractOnSepolia

# Optional: if you add more backends
# DATABASE_URL=postgresql://...